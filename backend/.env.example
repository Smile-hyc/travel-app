APP_NAME=AI Travel API
APP_VERSION=0.1.0
DEBUG=true
DEV_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
AMAP_WEB_SERVICE_KEY=
# 可选 UGC 适配器。只有取得相应数据使用授权后才可配置并启用。
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_CONNECT_TIMEOUT_SECONDS=5
TIKHUB_READ_TIMEOUT_SECONDS=12
TIKHUB_MAX_SOURCES=6
# 仅在已取得对应 UGC 数据使用授权后显式开启；有 Key 不等于已授权。
UGC_PROVIDER_AUTHORIZED=false
# 兼容旧配置；实际新鲜度由事实/客流/体验的分层 TTL 管理。
REVIEW_CACHE_TTL_SECONDS=21600
REVIEW_EMPTY_CACHE_TTL_SECONDS=300
REVIEW_DATABASE_PATH=data/reviews.sqlite3
# 生产环境必须替换，用于不可逆匿名化 UGC 作者标识。
REVIEW_AUTHOR_HASH_SALT=change-me-in-production
# 内容采集管理接口使用，至少 16 位；不要放进 Android 客户端。
CONTENT_ADMIN_TOKEN=
# MediaCrawler JSONL 导出目录；只读取 search_contents_*.jsonl。
MEDIACRAWLER_DATA_DIR=../tools/MediaCrawler/data/xhs/jsonl
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=240
DEEPSEEK_MAX_OUTPUT_TOKENS=8000
DEEPSEEK_TEMPERATURE=0.35
# 用户认证
USER_DATABASE_PATH=data/users.sqlite3
# 生产环境必须替换为随机字符串（openssl rand -hex 32）
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CAPTCHA_TTL_SECONDS=300